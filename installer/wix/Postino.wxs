<?xml version="1.0" encoding="utf-8"?>
<!--
  Postino per-user MSI (WiX Toolset v4).

  Scope: per-user, no elevation, no service, no autostart, no background updater.
  Files are generated by installer/Build-Msi.ps1 from the staged payload, so the
  binaries, runtime DLLs and hashes always match what the build produced.

  Build (from the repository root, after Build-Package.ps1 staged the payload):
    wix build -arch x64 `
      -d StageDir=dist\Postino-0.1.0-windows-x64 `
      -d ProductVersion=0.1.0 `
      installer\wix\Postino.wxs installer\wix\installer-ui.wxs installer\obj\StageFiles.wxs `
      -o dist\Postino-0.1.0-windows-x64.msi

  The dialogs are installer/wix/installer-ui.wxs: four native text-only screens, no WiX UI
  extension, no licence page and no banner artwork. The Windows Installer removes only what it
  installed: the program directory, the Start Menu shortcut and its own uninstall entry. User
  mail, attachments, settings and logs under %LOCALAPPDATA%\Postino and %APPDATA%\Postino are
  kept unless the person ticks the explicit checkbox on the maintenance page.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">

  <Package Name="Postino"
           Manufacturer="Postino"
           Version="$(var.ProductVersion)"
           UpgradeCode="4A8CC7B9-1C85-4C9C-A47C-C9FDBCC7981B"
           Scope="perUser"
           Compressed="yes"
           Language="1033">

    <Property Id="ARPPRODUCTICON" Value="PostinoIcon" />
    <Property Id="ARPCOMMENTS" Value="Uninstalling keeps local mail and settings unless you tick the delete checkbox. Manual installs only; Postino runs no background update service." />

    <MajorUpgrade DowngradeErrorMessage="A newer Postino is already installed. Uninstall it first." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="PostinoIcon" SourceFile="$(var.StageDir)\postino.ico" />

    <!-- Four text-only native dialogs; see installer-ui.wxs. -->
    <UIRef Id="PostinoInstallerUI" />

    <!-- Per-user locations. %LOCALAPPDATA%\Programs is the conventional no-admin home. -->
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="Postino" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="PostinoMenuFolder" Name="Postino" />
    </StandardDirectory>

    <Feature Id="Main" Title="Postino" Level="1">
      <ComponentGroupRef Id="ProductFiles" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>

    <!-- Default is off. The checkbox on the maintenance page can set it to 1. -->
    <Property Id="REMOVEDATA" Value="0" />

    <CustomAction Id="RemovePostinoUserData"
                  Directory="SystemFolder"
                  ExeCommand="cmd.exe /d /c rmdir /s /q &quot;[LocalAppDataFolder]Postino&quot; &amp; rmdir /s /q &quot;[AppDataFolder]Postino&quot;"
                  Execute="immediate"
                  Impersonate="yes"
                  Return="ignore" />

    <InstallExecuteSequence>
      <Custom Action="RemovePostinoUserData"
              After="RemoveFiles"
              Condition="REMOVEDATA=&quot;1&quot; AND REMOVE=&quot;ALL&quot;" />
    </InstallExecuteSequence>
  </Package>

  <Fragment>
    <Component Id="StartMenuShortcut" Directory="PostinoMenuFolder" Guid="BF9AE134-399B-44A9-92C7-52E79B9B71D6">
      <Shortcut Id="PostinoStartMenuShortcut"
                Name="Postino"
                Description="Postino - local-first mail"
                Target="[INSTALLFOLDER]postino-app.exe"
                WorkingDirectory="INSTALLFOLDER"
                Icon="PostinoIcon"
                Advertise="no" />
      <RemoveFolder Id="RemovePostinoMenuFolder" Directory="PostinoMenuFolder" On="uninstall" />
      <RegistryValue Root="HKCU"
                     Key="Software\Postino\Installer"
                     Name="StartMenuShortcut"
                     Type="integer"
                     Value="1"
                     KeyPath="yes" />
    </Component>
  </Fragment>

</Wix>
