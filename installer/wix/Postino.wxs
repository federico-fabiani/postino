<?xml version="1.0" encoding="utf-8"?>
<!--
  Postino per-user MSI (WiX Toolset v4).

  Scope: per-user, no elevation, no service, no autostart, no updater.
  Files are generated by installer/Build-Msi.ps1 from the staged payload, so the
  binaries, runtime DLLs and hashes always match what the build produced.

  Build (from the repository root, after Build-Package.ps1 staged the payload):
    wix build -arch x64 -ext WixToolset.UI.wixext `
      -d StageDir=dist\Postino-0.1.0-windows-x64 `
      -d ProductVersion=0.1.0 `
      -d LicenseRtf=installer\wix\license.rtf `
      installer\wix\Postino.wxs installer\obj\StageFiles.wxs `
      -o dist\Postino-0.1.0-windows-x64.msi

  The Windows Installer removes only what it installed: the program directory,
  the Start Menu shortcut and its own uninstall entry. User mail, attachments,
  settings and logs under %LOCALAPPDATA%\Postino and %APPDATA%\Postino are kept
  unless the person ticks the explicit checkbox on the uninstall path.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <Package Name="Postino"
           Manufacturer="Postino"
           Version="$(var.ProductVersion)"
           UpgradeCode="4A8CC7B9-1C85-4C9C-A47C-C9FDBCC7981B"
           Scope="perUser"
           Compressed="yes"
           Language="1033"
           ARPPRODUCTICON="PostinoIcon"
           ARPCOMMENTS="Uninstalling keeps local mail and settings unless you tick the delete checkbox. Manual installs only; Postino runs no background update service.">

    <MajorUpgrade DowngradeErrorMessage="A newer Postino is already installed. Uninstall it first." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="PostinoIcon" SourceFile="$(var.StageDir)\postino.ico" />
    <WixVariable Id="WixUILicenseRtf" Value="$(var.LicenseRtf)" />
    <ui:WixUI Id="WixUI_Minimal" />

    <!-- Per-user locations. %LOCALAPPDATA%\Programs is the conventional no-admin home. -->
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="Postino" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="PostinoMenuFolder" Name="Postino" />
    </StandardDirectory>

    <Feature Id="Main" Title="Postino" Level="1">
      <ComponentGroupRef Id="ProductFiles" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>

    <!-- Default is off. The checkbox on PostinoRemoveDataDlg can set it to 1. -->
    <Property Id="REMOVEDATA" Value="0" />

    <CustomAction Id="RemovePostinoUserData"
                  ExeCommand="[SystemFolder]cmd.exe /d /c rmdir /s /q &quot;[LocalAppDataFolder]Postino&quot; &amp; rmdir /s /q &quot;[AppDataFolder]Postino&quot;"
                  Execute="immediate"
                  Impersonate="yes"
                  Return="ignore" />

    <InstallExecuteSequence>
      <CustomAction Id="RemovePostinoUserData"
                    After="RemoveFiles"
                    Condition="REMOVEDATA=&quot;1&quot; AND REMOVE=&quot;ALL&quot;" />
    </InstallExecuteSequence>
  </Package>

  <Fragment>
    <Component Id="StartMenuShortcut" Directory="PostinoMenuFolder" Guid="BF9AE134-399B-44A9-92C7-52E79B9B71D6">
      <Shortcut Id="PostinoStartMenuShortcut"
                Name="Postino"
                Description="Postino - local-first mail"
                Target="[INSTALLFOLDER]postino-app.exe"
                WorkingDirectory="INSTALLFOLDER"
                Icon="PostinoIcon"
                Advertise="no" />
      <RemoveFolder Id="RemovePostinoMenuFolder" Directory="PostinoMenuFolder" On="uninstall" />
      <RegistryValue Root="HKCU"
                     Key="Software\Postino\Installer"
                     Name="StartMenuShortcut"
                     Type="integer"
                     Value="1"
                     KeyPath="yes" />
    </Component>
  </Fragment>

  <!-- A custom uninstall step: a clear, default-off choice for local data. -->
  <Fragment>
    <UI>
      <Dialog Id="PostinoRemoveDataDlg" Width="370" Height="270" Title="[ProductName] Setup">
        <Control Id="Title" Type="Text" X="15" Y="6" Width="340" Height="15"
                 Transparent="yes" NoPrefix="yes" Text="{\WixUI_Font_Title}Remove Postino" />
        <Control Id="BannerLine" Type="Line" X="0" Y="20" Width="370" Height="1" />
        <Control Id="Description" Type="Text" X="15" Y="30" Width="340" Height="45"
                 Transparent="yes" NoPrefix="yes"
                 Text="Setup will remove the Postino program files, the Start Menu shortcut and the uninstall entry." />
        <Control Id="DataIntro" Type="Text" X="15" Y="80" Width="340" Height="35"
                 Transparent="yes" NoPrefix="yes"
                 Text="Your mail, attachments, account settings and logs stay on this PC by default." />
        <Control Id="RemoveDataCheckBox" Type="CheckBox" X="15" Y="125" Width="340" Height="30"
                 Property="REMOVEDATA" CheckBoxValue="1"
                 Text="Also delete my local mail, attachments, settings and logs" />
        <Control Id="DataPathNote" Type="Text" X="30" Y="160" Width="325" Height="30"
                 Transparent="yes" NoPrefix="yes"
                 Text="That deletes %LOCALAPPDATA%\Postino and %APPDATA%\Postino. Credentials in Windows Credential Manager are not touched." />
        <Control Id="KeepDataNote" Type="Text" X="15" Y="195" Width="340" Height="20"
                 Transparent="yes" NoPrefix="yes"
                 Text="Leave the box unchecked to keep everything for a future reinstall." />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="1" />
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17"
                 Text="!(loc.WixUIBack)">
          <Publish Event="NewDialog" Value="MaintenanceTypeDlg" />
        </Control>
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17"
                 Default="yes" Text="!(loc.WixUINext)">
          <Publish Event="NewDialog" Value="VerifyReadyDlg" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17"
                 Cancel="yes" Text="!(loc.WixUICancel)">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
      </Dialog>

      <!-- Order 2 runs after the stock event and replaces its target. -->
      <Publish Dialog="MaintenanceTypeDlg" Control="RemoveButton"
               Event="NewDialog" Value="PostinoRemoveDataDlg" Order="2">1</Publish>
    </UI>
  </Fragment>

</Wix>
